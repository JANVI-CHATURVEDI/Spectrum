# SwachDrishti Backend Environment Configuration
SECRET_KEY=generate-a-strong-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=swachdrishti.onrender.com,localhost,127.0.0.1
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://swachdrishti.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://swachdrishti.vercel.app,https://swachdrishti.onrender.com

# Database (Neon PostgreSQL connection string for production)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-royal-wave-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI Engine (Google Gemini API Key - Optional, heuristic fallback active if omitted)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
